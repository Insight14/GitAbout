# GitHub API Token (Optional for basic public queries, recommended for GraphQL batching and higher rate limits)
GITHUB_TOKEN=

# Google Gemini API (Required for LLM bullet drafting)
GEMINI_API_KEY=
# Model name to use (e.g. gemini-3.5-flash) - never hardcoded in code
GEMINI_MODEL=gemini-3.5-flash

# Upstash Redis (Optional in local dev: falls back to in-memory cache and rate limiting if not configured)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
